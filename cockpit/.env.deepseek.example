# cockpit/.env for DeepSeek -- a working configuration: copy it to .env and put
# your DeepSeek API key in place of every `sk-...` value -- the ones here are
# invented. The same key four times is fine; a key per role lets you tell their
# usage apart. Everything else is set.
#
# All four roles run on the same model here. That works, but the reviewer H'
# then reviews what its own model wrote, and the cockpit says so: another model
# for SGE_REVIEWER_* makes its review independent.
#
# MAX_TOKENS for P and H': DeepSeek's default output limit cut a goal check off at
# high reasoning; 65536 leaves room (the model allows 393216).
#
# I and C need the Codex CLI (https://github.com/openai/codex):
#   npm install -g @openai/codex
# Check the result -- never the key:  uv run python role_agent.py --describe
# The full reference, with every setting explained: .env.example

# P -- the planner
SGE_PLANNER_BASE_URL=https://api.deepseek.com
SGE_PLANNER_API_KEY=sk-...a7c
SGE_PLANNER_MODEL=deepseek-flash
SGE_PLANNER_REASONING_EFFORT=high
SGE_PLANNER_MAX_TOKENS=65536

# H' -- the reviewer
SGE_REVIEWER_BASE_URL=https://api.deepseek.com
SGE_REVIEWER_API_KEY=sk-...b3e
SGE_REVIEWER_MODEL=deepseek-flash
SGE_REVIEWER_REASONING_EFFORT=high
SGE_REVIEWER_MAX_TOKENS=65536

# I -- the intent author of a run
SGE_INTENT_BASE_URL=https://api.deepseek.com
SGE_INTENT_API_KEY=sk-...d91
SGE_INTENT_MODEL=deepseek-flash
SGE_INTENT_REASONING_EFFORT=high
SGE_INTENT_HARNESS=codex-cli

# C -- the coder
SGE_CODER_BASE_URL=https://api.deepseek.com
SGE_CODER_API_KEY=sk-...f42
SGE_CODER_MODEL=deepseek-flash
SGE_CODER_REASONING_EFFORT=high
SGE_CODER_HARNESS=codex-cli
